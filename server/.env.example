# ==============================================================================
# Stacked Application Environment Configuration (Server)
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGO_INITDB_ROOT_USERNAME=stacked_admin
MONGO_INITDB_ROOT_PASSWORD=stacked_secret
MONGO_INITDB_DATABASE=stacked_db
MONGODB_URI=mongodb://stacked_admin:stacked_secret@localhost:27017/stacked_db?authSource=admin

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=stacked_redis_secret
REDIS_TIMEOUT=2000ms

# Application URLs & CORS Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# File Storage Configuration
FILE_STORAGE_TEMP_PATH=uploads/temp
FILE_STORAGE_PERMANENT_PATH=uploads/permanent
FILE_STORAGE_MAX_SIZE=10485760
FILE_CLEANUP_CRON=0 0 * * * *
FILE_TEMP_TTL=PT1H



