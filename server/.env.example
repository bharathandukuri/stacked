# Server Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
BACKEND_URL=http://localhost:8080

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGO_INITDB_ROOT_USERNAME=stacked_admin
MONGO_INITDB_ROOT_PASSWORD=stacked_secret
MONGO_INITDB_DATABASE=stacked_db
MONGODB_URI=mongodb://stacked_admin:stacked_secret@localhost:27017/stacked_db?authSource=admin

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=stacked_redis_secret
REDIS_TIMEOUT=2000ms

# Docker Execution Sandbox Configuration
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_ENABLED=true

# JWT & Authentication Security (Must be at least 256 bits / 32 bytes; replace in production!)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Cookie Security
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/

# Initial Default Admin Provisioning (Change password in production, or set ADMIN_DEFAULT_ENABLED=false)
ADMIN_DEFAULT_ENABLED=true
ADMIN_DEFAULT_EMAIL=admin@stacked.com
ADMIN_DEFAULT_PASSWORD=Admin@123456
ADMIN_DEFAULT_NAME=Platform Admin

# Application URLs & CORS Configuration
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
