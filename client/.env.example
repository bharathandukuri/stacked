# ==============================================================================
# Stacked Client Environment Configuration
# ==============================================================================

# API Base URL (defaults to /api for dev reverse-proxy; change to full URL if direct)
VITE_API_BASE_URL=/api

# Backend Server URL (used by Vite proxy in development or direct connection)
VITE_BACKEND_URL=http://localhost:8080

# Frontend URL
VITE_FRONTEND_URL=http://localhost:3000

# Client Dev Server Port
PORT=3000
