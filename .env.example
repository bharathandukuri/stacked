# ==============================================================================
# Stacked Application Environment Configuration
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGO_INITDB_ROOT_USERNAME=stacked_admin
MONGO_INITDB_ROOT_PASSWORD=stacked_secret
MONGO_INITDB_DATABASE=stacked_db
MONGODB_URI=mongodb://stacked_admin:stacked_secret@localhost:27017/stacked_db?authSource=admin

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=stacked_redis_secret
REDIS_TIMEOUT=2000ms

# Application URLs & CORS Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# File Storage Configuration
FILE_STORAGE_TEMP_PATH=uploads/temp
FILE_STORAGE_PERMANENT_PATH=uploads/permanent
FILE_STORAGE_MAX_SIZE=10485760
FILE_CLEANUP_CRON=0 0 * * * *
FILE_TEMP_TTL=PT1H

# ==============================================================================
# Online Judge & Sandboxing Configuration
# ==============================================================================
# Sandbox Driver: DOCKER or FIRECRACKER
JUDGE_SANDBOX_DRIVER=DOCKER
JUDGE_DEFAULT_TIMEOUT_MS=5000
JUDGE_COMPILE_TIMEOUT_MS=10000
JUDGE_MAX_OUTPUT_SIZE_BYTES=65536
JUDGE_WORKSPACE_DIR=/tmp/stacked/workspace

# Docker Sandbox Settings (Connects to docker-sandbox compose service)
JUDGE_DOCKER_PORT=2375
JUDGE_DOCKER_HOST=tcp://localhost:2375
JUDGE_DOCKER_CLI=docker
JUDGE_DOCKER_NETWORK=none
JUDGE_DOCKER_READ_ONLY=true
JUDGE_DOCKER_PIDS_LIMIT=128
JUDGE_DOCKER_CPUS=1.0
JUDGE_DOCKER_MEMORY_LIMIT_MB=256

# Firecracker MicroVM Settings (Connects to firecracker-sandbox compose service)
JUDGE_FIRECRACKER_PORT=8085
JUDGE_FIRECRACKER_SERVICE_URL=http://localhost:8085
JUDGE_FIRECRACKER_BIN=/usr/local/bin/firecracker
JUDGE_FIRECRACKER_SOCKET_DIR=/tmp/firecracker
JUDGE_FIRECRACKER_KERNEL=/var/lib/firecracker/kernel/vmlinux
JUDGE_FIRECRACKER_ROOTFS_DIR=/var/lib/firecracker/rootfs
JUDGE_FIRECRACKER_VCPU_COUNT=1
JUDGE_FIRECRACKER_MEM_SIZE_MIB=256

